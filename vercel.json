{
  "version": 2,
  "routes": [
    { "src": "/app",       "dest": "/app.html" },
    { "src": "/login",     "dest": "/login.html" },
    { "src": "/signup",    "dest": "/login.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/pricing",   "dest": "/payments.html" },
    { "src": "/blog",      "dest": "/seo-blog.html" },
    { "src": "/analytics", "dest": "/analytics.html" },
    { "src": "/docs",      "dest": "/api-docs.html" },
    { "src": "/about",     "dest": "/pages.html" },
    { "src": "/contact",   "dest": "/pages.html" },
    { "src": "/privacy",   "dest": "/pages.html" },
    { "src": "/terms",     "dest": "/pages.html" },
    { "src": "/",          "dest": "/index.html" },
    { "src": "/(.*)",      "dest": "/pages.html" }
  ]
}
